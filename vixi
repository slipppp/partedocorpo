        if DropdownScroll.Visible then
            local mousePos = Vector2.new(Mouse.X, Mouse.Y)
            local scrollPos = DropdownScroll.AbsolutePosition
            local scrollSize = DropdownScroll.AbsoluteSize
            
            if not (mousePos.X >= scrollPos.X and mousePos.X <= scrollPos.X + scrollSize.X and
                    mousePos.Y >= scrollPos.Y and mousePos.Y <= scrollPos.Y + scrollSize.Y) then
                DropdownScroll.Visible = false
            end
        end
    end
end)

