-- ========== BIBLIOTECA UI SIMPLIFICADA ==========
local Library = {}
Library.__index = Library

function Library:Create(className, properties, parent)
    local obj = Instance.new(className)
    for prop, value in pairs(properties) do
        obj[prop] = value
    end
    if parent then obj.Parent = parent end
    return obj
end

function Library:Tween(obj, info, properties)
    TweenService:Create(obj, info, properties):Play()
end

-- ========== FUNÇÕES DE DETECÇÃO ==========
local function DetectCharacterType()
    local char = LocalPlayer.Character
    if not char then return "R15" end
    
    -- Verifica se tem partes R15
    local r15Parts = {"UpperTorso", "LowerTorso", "LeftUpperArm", "RightUpperArm", 
                      "LeftLowerArm", "RightLowerArm", "LeftUpperLeg", "RightUpperLeg", 
                      "LeftLowerLeg", "RightLowerLeg"}
    
    for _, part in pairs(r15Parts) do
        if char:FindFirstChild(part) then
            return "R15"
        end
    end
    return "R6"
end

-- ========== CRIAR VIEWPORT PARA MODELO 3D ==========
local function CreateViewport(parent)
    -- ViewportFrame para renderizar 3D
    local viewport = Library:Create("ViewportFrame", {
        BackgroundColor3 = Color3.fromRGB(20, 20, 25),
        BorderColor3 = Color3.fromRGB(40, 40, 50),
        BorderSizePixel = 1,
        Position = UDim2.new(0, 0, 0, 0),
        Size = UDim2.new(1, 0, 1, 0),
        CurrentCamera = Instance.new("Camera"),
    }, parent)
    
    -- Configurar câmera
    local camera = viewport.CurrentCamera
    camera.FieldOfView = 50
    camera.CFrame = CFrame.new(0, 2, 5) * CFrame.Angles(-0.2, 0, 0)
    
    -- Iluminação
    local light = Instance.new("PointLight")
    light.Parent = camera
    light.Brightness = 5
    light.Range = 20
    
    return viewport
end

-- ========== CRIAR MODELO R15 REAL ==========
local function CreateRealR15Character(viewport, characterType, onPartClick)
    local parts = {}
    local selectedPart = nil
    local highlightObjects = {}
    
    -- Cores padrão R15
    local colors = {
        Head = Color3.fromRGB(220, 200, 180),
        UpperTorso = Color3.fromRGB(180, 160, 200),
        LowerTorso = Color3.fromRGB(160, 140, 180),
        LeftUpperArm = Color3.fromRGB(180, 160, 140),
        RightUpperArm = Color3.fromRGB(180, 160, 140),
        LeftLowerArm = Color3.fromRGB(160, 140, 120),
        RightLowerArm = Color3.fromRGB(160, 140, 120),
        LeftHand = Color3.fromRGB(200, 180, 160),
        RightHand = Color3.fromRGB(200, 180, 160),
        LeftUpperLeg = Color3.fromRGB(140, 120, 100),
        RightUpperLeg = Color3.fromRGB(140, 120, 100),
        LeftLowerLeg = Color3.fromRGB(120, 100, 80),
        RightLowerLeg = Color3.fromRGB(120, 100, 80),
        LeftFoot = Color3.fromRGB(120, 100, 80),
        RightFoot = Color3.fromRGB(120, 100, 80),
    }
    
    -- Criar modelo
    local function CreatePart(partName, size, cframe, color, isR15)
        -- Criar parte com mesh ou block
        local part = Instance.new("Part")
        part.Name = partName
        part.Size = size
        part.CFrame = cframe
        part.Color = color
        part.Material = Enum.Material.SmoothPlastic
        part.Anchored = true
        part.CanCollide = false
        part.Parent = viewport
        
        -- Adicionar mesh para parecer mais realista
        if isR15 then
            local mesh = Instance.new("SpecialMesh")
            mesh.MeshType = Enum.MeshType.FileMesh
            mesh.MeshId = "rbxassetid://" .. GetMeshId(partName)
            mesh.Scale = size / 2
            mesh.Parent = part
        end
        
        -- Caixa de clique invisível (para interação)
        local clickDetector = Instance.new("ClickDetector")
        clickDetector.Parent = part
        clickDetector.MaxActivationDistance = 100
        
        clickDetector.MouseClick:Connect(function()
            if onPartClick then
                onPartClick(partName)
            end
            HighlightPart(partName)
        end)
        
        -- Highlight quando hover (usando um outline)
        local highlight = Instance.new("Highlight")
        highlight.Parent = part
        highlight.Enabled = false
        highlight.FillColor = Color3.fromRGB(84, 101, 255)
        highlight.FillTransparency = 0.5
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.OutlineTransparency = 0.3
        
        parts[partName] = {
            part = part,
            highlight = highlight,
            originalColor = color,
            clickDetector = clickDetector
        }
        
        return part
    end
    
    -- IDs de mesh para R15
    local function GetMeshId(partName)
        local meshes = {
            Head = "http://www.roblox.com/asset/?id=47551917",
            UpperTorso = "http://www.roblox.com/asset/?id=47224645",
            LowerTorso = "http://www.roblox.com/asset/?id=47224645",
            LeftUpperArm = "http://www.roblox.com/asset/?id=47230408",
            RightUpperArm = "http://www.roblox.com/asset/?id=47230408",
            LeftLowerArm = "http://www.roblox.com/asset/?id=47230408",
            RightLowerArm = "http://www.roblox.com/asset/?id=47230408",
            LeftHand = "http://www.roblox.com/asset/?id=47230408",
            RightHand = "http://www.roblox.com/asset/?id=47230408",
            LeftUpperLeg = "http://www.roblox.com/asset/?id=47230408",
            RightUpperLeg = "http://www.roblox.com/asset/?id=47230408",
            LeftLowerLeg = "http://www.roblox.com/asset/?id=47230408",
            RightLowerLeg = "http://www.roblox.com/asset/?id=47230408",
            LeftFoot = "http://www.roblox.com/asset/?id=47230408",
            RightFoot = "http://www.roblox.com/asset/?id=47230408",
        }
        return meshes[partName] or "http://www.roblox.com/asset/?id=47230408"
    end
    
    -- Criar personagem R15 completo
    local function BuildR15()
        local torsoCF = CFrame.new(0, 2, 0)
        local leftCF = torsoCF * CFrame.new(-1.5, 0.5, 0)
        local rightCF = torsoCF * CFrame.new(1.5, 0.5, 0)
        
        -- Cabeça
        CreatePart("Head", Vector3.new(2, 2, 2), torsoCF * CFrame.new(0, 2.5, 0), colors.Head, true)
        
        -- Tronco superior
        CreatePart("UpperTorso", Vector3.new(2.5, 1.5, 1.5), torsoCF * CFrame.new(0, 1.2, 0), colors.UpperTorso, true)
        
        -- Tronco inferior
        CreatePart("LowerTorso", Vector3.new(2, 1.2, 1.5), torsoCF * CFrame.new(0, 0, 0), colors.LowerTorso, true)
        
        -- Braços superiores
        CreatePart("LeftUpperArm", Vector3.new(1, 1.5, 1), leftCF * CFrame.new(0, 0.8, 0), colors.LeftUpperArm, true)
        CreatePart("RightUpperArm", Vector3.new(1, 1.5, 1), rightCF * CFrame.new(0, 0.8, 0), colors.RightUpperArm, true)
        
        -- Braços inferiores
        CreatePart("LeftLowerArm", Vector3.new(0.8, 1.2, 0.8), leftCF * CFrame.new(0, -0.2, 0), colors.LeftLowerArm, true)
        CreatePart("RightLowerArm", Vector3.new(0.8, 1.2, 0.8), rightCF * CFrame.new(0, -0.2, 0), colors.RightLowerArm, true)
        
        -- Mãos
        CreatePart("LeftHand", Vector3.new(0.6, 0.6, 0.6), leftCF * CFrame.new(0, -1, 0), colors.LeftHand, true)
        CreatePart("RightHand", Vector3.new(0.6, 0.6, 0.6), rightCF * CFrame.new(0, -1, 0), colors.RightHand, true)
        
        -- Pernas superiores
        CreatePart("LeftUpperLeg", Vector3.new(1, 1.5, 1), torsoCF * CFrame.new(-0.8, -1.2, 0), colors.LeftUpperLeg, true)
        CreatePart("RightUpperLeg", Vector3.new(1, 1.5, 1), torsoCF * CFrame.new(0.8, -1.2, 0), colors.RightUpperLeg, true)
        
        -- Pernas inferiores
        CreatePart("LeftLowerLeg", Vector3.new(0.8, 1.5, 0.8), torsoCF * CFrame.new(-0.8, -2.5, 0), colors.LeftLowerLeg, true)
        CreatePart("RightLowerLeg", Vector3.new(0.8, 1.5, 0.8), torsoCF * CFrame.new(0.8, -2.5, 0), colors.RightLowerLeg, true)
        
        -- Pés
        CreatePart("LeftFoot", Vector3.new(1.2, 0.5, 1.5), torsoCF * CFrame.new(-0.8, -3.5, 0.5), colors.LeftFoot, true)
        CreatePart("RightFoot", Vector3.new(1.2, 0.5, 1.5), torsoCF * CFrame.new(0.8, -3.5, 0.5), colors.RightFoot, true)
    end
    
    -- Criar personagem R6
    local function BuildR6()
        local torsoCF = CFrame.new(0, 2, 0)
        
        -- Cabeça
        CreatePart("Head", Vector3.new(2, 2, 2), torsoCF * CFrame.new(0, 2.5, 0), Color3.fromRGB(220, 200, 180), false)
        
        -- Torso
        CreatePart("Torso", Vector3.new(3, 2.5, 1.5), torsoCF * CFrame.new(0, 1.2, 0), Color3.fromRGB(180, 160, 200), false)
        
        -- Braços
        CreatePart("LeftArm", Vector3.new(1.2, 2.5, 1.2), torsoCF * CFrame.new(-2.5, 1.2, 0), Color3.fromRGB(180, 160, 140), false)
        CreatePart("RightArm", Vector3.new(1.2, 2.5, 1.2), torsoCF * CFrame.new(2.5, 1.2, 0), Color3.fromRGB(180, 160, 140), false)
        
        -- Pernas
        CreatePart("LeftLeg", Vector3.new(1.5, 2.5, 1.5), torsoCF * CFrame.new(-1, -0.5, 0), Color3.fromRGB(140, 120, 100), false)
        CreatePart("RightLeg", Vector3.new(1.5, 2.5, 1.5), torsoCF * CFrame.new(1, -0.5, 0), Color3.fromRGB(140, 120, 100), false)
    end
    
    -- Construir personagem
    if characterType == "R15" then
        BuildR15()
    else
        BuildR6()
    end
    
    -- Função para destacar parte
    function HighlightPart(partName)
        -- Resetar todos os highlights
        for _, data in pairs(parts) do
            data.highlight.Enabled = false
        end
        
        -- Destacar parte selecionada
        if partName and parts[partName] then
            local data = parts[partName]
            data.highlight.Enabled = true
            selectedPart = partName
            
            -- Efeito de pulso com Tween
            spawn(function()
                local tween = TweenService:Create(data.highlight, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
                    FillTransparency = 0.2
                })
                tween:Play()
                wait(0.5)
                tween:Cancel()
                data.highlight.FillTransparency = 0.5
            end)
        end
    end
    
    -- Rotacionar modelo
    local rotation = 0
    RunService.Heartbeat:Connect(function(dt)
        rotation = rotation + dt * 0.5
        for _, data in pairs(parts) do
            if data.part then
                -- Rotacionar gradualmente
                data.part.CFrame = data.part.CFrame * CFrame.Angles(0, dt * 0.5, 0)
            end
        end
    end)
    
    -- Funções públicas
    return {
        HighlightPart = HighlightPart,
        GetSelected = function() return selectedPart end,
        GetParts = function()
            local partList = {}
            for name, _ in pairs(parts) do
                table.insert(partList, name)
            end
            return partList
        end
    }
end

