-- ========== CRIAR BONECO ==========
local function CreateCharacterPreview(parent, characterType, onPartClick)
    local previewFrame = Library:Create("Frame", {
        BackgroundColor3 = Color3.fromRGB(20, 20, 25),
        BorderColor3 = Color3.fromRGB(40, 40, 50),
        BorderSizePixel = 1,
        Position = UDim2.new(0, 0, 0, 0),
        Size = UDim2.new(1, 0, 1, 0),
        ClipsDescendants = true,
    }, parent)
    
    -- Título
    Library:Create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0.5, 0, 0, 8),
        Size = UDim2.new(1, -20, 0, 25),
        Font = Enum.Font.Ubuntu,
        Text = "👤 " .. characterType .. " Character",
        TextColor3 = Color3.fromRGB(200, 200, 200),
        TextSize = 16,
        TextXAlignment = Enum.TextXAlignment.Center,
        AnchorPoint = Vector2.new(0.5, 0),
    }, previewFrame)
    
    -- Container do boneco
    local avatarContainer = Library:Create("Frame", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 10, 0, 35),
        Size = UDim2.new(1, -20, 1, -45),
    }, previewFrame)
    
    -- Mapa das partes
    local partHighlights = {}
    local selectedPart = nil
    
    -- Função para criar uma parte
    local function CreatePart(name, color, x, y, w, h, parent)
        local part = Library:Create("TextButton", {
            BackgroundColor3 = color,
            BorderColor3 = Color3.fromRGB(60, 60, 70),
            BorderSizePixel = 1,
            Position = UDim2.new(x - w/2, 0, y - h/2, 0),
            Size = UDim2.new(w, 0, h, 0),
            Text = "",
            AutoButtonColor = false,
            Name = name,
            ZIndex = 2,
        }, parent)
        
        -- Label para mostrar nome
        local label = Library:Create("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.new(0.5, 0, 0.5, 0),
            Size = UDim2.new(1, 0, 1, 0),
            Font = Enum.Font.Ubuntu,
            Text = name,
            TextColor3 = Color3.fromRGB(255, 255, 255),
            TextSize = 7,
            TextScaled = true,
            TextWrapped = true,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Visible = false,
            ZIndex = 3,
        }, part)
        
        -- Hover
        part.MouseEnter:Connect(function()
            label.Visible = true
            if selectedPart ~= name then
                part.BorderColor3 = Color3.fromRGB(255, 255, 255)
                part.BorderSizePixel = 2
            end
        end)
        
        part.MouseLeave:Connect(function()
            label.Visible = false
            if selectedPart ~= name then
                part.BorderColor3 = Color3.fromRGB(60, 60, 70)
                part.BorderSizePixel = 1
            end
        end)
        
        -- Click
        part.MouseButton1Down:Connect(function()
            if onPartClick then
                onPartClick(name)
            end
            HighlightPart(name)
        end)
        
        partHighlights[name] = {
            part = part,
            originalColor = color,
            label = label
        }
        
        return part
    end
    
    -- Função para destacar
    function HighlightPart(name)
        -- Reset
        for _, data in pairs(partHighlights) do
            data.part.BackgroundColor3 = data.originalColor
            data.part.BorderColor3 = Color3.fromRGB(60, 60, 70)
            data.part.BorderSizePixel = 1
            data.label.Visible = false
        end
        
        -- Highlight
        if name and partHighlights[name] then
            local data = partHighlights[name]
            data.part.BackgroundColor3 = Color3.fromRGB(84, 101, 255)
            data.part.BorderColor3 = Color3.fromRGB(255, 255, 255)
            data.part.BorderSizePixel = 3
            data.label.Visible = true
            selectedPart = name
        end
    end
    
    -- Criar partes
    if characterType == "R15" then
        -- Cabeça
        CreatePart("Head", Color3.fromRGB(220, 200, 180), 0.5, 0.08, 0.26, 0.14, avatarContainer)
        -- Tronco superior
        CreatePart("UpperTorso", Color3.fromRGB(160, 140, 200), 0.5, 0.20, 0.35, 0.12, avatarContainer)
        -- Tronco inferior
        CreatePart("LowerTorso", Color3.fromRGB(140, 120, 180), 0.5, 0.32, 0.30, 0.10, avatarContainer)
        -- Braços superiores
        CreatePart("LeftUpperArm", Color3.fromRGB(180, 160, 140), 0.20, 0.20, 0.10, 0.10, avatarContainer)
        CreatePart("RightUpperArm", Color3.fromRGB(180, 160, 140), 0.80, 0.20, 0.10, 0.10, avatarContainer)
        -- Braços inferiores
        CreatePart("LeftLowerArm", Color3.fromRGB(160, 140, 120), 0.17, 0.32, 0.08, 0.10, avatarContainer)
        CreatePart("RightLowerArm", Color3.fromRGB(160, 140, 120), 0.83, 0.32, 0.08, 0.10, avatarContainer)
        -- Mãos
        CreatePart("LeftHand", Color3.fromRGB(200, 180, 160), 0.14, 0.44, 0.05, 0.05, avatarContainer)
        CreatePart("RightHand", Color3.fromRGB(200, 180, 160), 0.86, 0.44, 0.05, 0.05, avatarContainer)
        -- Pernas superiores
        CreatePart("LeftUpperLeg", Color3.fromRGB(140, 120, 100), 0.35, 0.45, 0.12, 0.13, avatarContainer)
        CreatePart("RightUpperLeg", Color3.fromRGB(140, 120, 100), 0.65, 0.45, 0.12, 0.13, avatarContainer)
        -- Pernas inferiores
        CreatePart("LeftLowerLeg", Color3.fromRGB(120, 100, 80), 0.35, 0.62, 0.10, 0.13, avatarContainer)
        CreatePart("RightLowerLeg", Color3.fromRGB(120, 100, 80), 0.65, 0.62, 0.10, 0.13, avatarContainer)
        -- Pés
        CreatePart("LeftFoot", Color3.fromRGB(120, 100, 80), 0.33, 0.78, 0.08, 0.06, avatarContainer)
        CreatePart("RightFoot", Color3.fromRGB(120, 100, 80), 0.67, 0.78, 0.08, 0.06, avatarContainer)
    else -- R6
        -- Cabeça
        CreatePart("Head", Color3.fromRGB(220, 200, 180), 0.5, 0.10, 0.28, 0.16, avatarContainer)
        -- Torso
        CreatePart("Torso", Color3.fromRGB(160, 140, 200), 0.5, 0.26, 0.38, 0.20, avatarContainer)
        -- Braços
        CreatePart("LeftArm", Color3.fromRGB(180, 160, 140), 0.18, 0.26, 0.12, 0.20, avatarContainer)
        CreatePart("RightArm", Color3.fromRGB(180, 160, 140), 0.82, 0.26, 0.12, 0.20, avatarContainer)
        -- Pernas
        CreatePart("LeftLeg", Color3.fromRGB(140, 120, 100), 0.35, 0.50, 0.14, 0.26, avatarContainer)
        CreatePart("RightLeg", Color3.fromRGB(140, 120, 100), 0.65, 0.50, 0.14, 0.26, avatarContainer)
    end
    
    -- Funções públicas
    function previewFrame:HighlightPart(name)
        HighlightPart(name)
    end
    
    function previewFrame:GetSelected()
        return selectedPart
    end
    
    return previewFrame
end

